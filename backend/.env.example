# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://smart_farm:change-me@localhost:5432/smart_farm

# MQTT broker (local EMQX by default)
MQTT_ENABLED=true
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_CLIENT_ID=smart-farm-backend
MQTT_TOPIC_PREFIX=sf-kandang-sapih
MQTT_PUBLISH_TIMEOUT=5

# Protect device registration and control endpoints; use long random values.
API_ADMIN_TOKEN=replace-with-a-long-random-admin-token
API_CONTROL_TOKEN=replace-with-a-long-random-control-token
API_CONTROL_ISSUER=operator-token
COMMAND_TTL_SECONDS=30

# Laptop YOLOv8 edge gateway MJPEG endpoint, for example http://192.168.1.50:5001/video_feed
SMART_GATE_STREAM_URL=

# Defaults to the sibling folder "backend kel 2/model".
# Set this only if the Group 2 model artifacts are stored elsewhere.
GROUP2_MODEL_DIR=
GROUP2_CORS_ORIGINS=*

PORT=5000
